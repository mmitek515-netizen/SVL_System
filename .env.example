# A new backend; no old GitHub/Codex backend required. Generate distinct secrets using python3 -c 'import secrets;print(secrets.token_urlsafe(48))'.
PORT=3000
SVL_OPERATOR_TOKEN=
SVL_HTTPS=false
DATA_DIR=data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SVL_LINUX_SYNC_TOKEN=
# Four distinct 32+ character tokens for authenticated independent worker callbacks:
SVL_WORKER_TOKENS={}
# Host-only variables in /etc/bastillaos/linux-sync.env, never in frontend:
# SVL_BACKEND_URL=https://your-app.example
# SVL_LINUX_SYNC_TOKEN=the-same-secret
# SVL_SYNC_INTERVAL=15

# PRIMARY ENGINE — OpenCode with ChatGPT Plus/Pro sign-in on Debian host.
# Run `opencode auth login openai` interactively on the host.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Enable remote HTTPS OpenCode only if deployed behind trusted VPN/proxy with auth.
OPENCODE_ALLOW_REMOTE=false
# Must be explicitly enabled; otherwise errors are visible and no fallback masks missing ChatGPT login.
SVL_ALLOW_OLLAMA_FALLBACK=false
