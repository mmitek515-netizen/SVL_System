# Optional Pro key for image generation. This is not used by the
# deterministic Triad command protocol.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# Local Ollama powers chat. Pull this model before starting SVL.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:270m"

# Optional: Google Gemini is used by the separate VM_Gemini_4 profile and health check.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.7-flash"

# Optional URL where the app is hosted, used for self-referential links,
# OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
