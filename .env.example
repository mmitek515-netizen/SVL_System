# Google Gemini API — główne API rozmowy z agentami Triady (Alex, Astyria, Aurelius)
# oraz konsoli HyperOS. Darmowy klucz: https://aistudio.google.com/apikey
# Skopiuj ten plik jako .env (lub .env.local) i wpisz swój klucz.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Kolejne modele (po przecinku) próbowane przy limicie lub awarii głównego.
GEMINI_FALLBACK_MODELS="gemini-3.7-flash"

# Autonomia Triady (misja BUILD_BEST_OS): Alex planuje, Astyria buduje,
# Aurelius weryfikuje — w pętli, bez udziału Operatora. Wymaga klucza API powyżej.
# TRIAD_AUTONOMY=off wyłącza pętlę (można też przełączać w panelu Misji Astyrii).
TRIAD_AUTONOMY="on"
# Gdzie agenci wykonują polecenia jako root:
#   docker — piaskownica "triada-forge" (Debian Trixie, root, repozytorium w /workspace) [domyślnie]
#   host   — bezpośrednio w systemie gospodarza, root bez izolacji
TRIAD_AUTONOMY_EXECUTOR="docker"
TRIAD_AUTONOMY_INTERVAL_MIN="10"
TRIAD_AUTONOMY_MAX_CYCLES_PER_DAY="48"

# OpenRouter API — zapasowy provider, gdy Gemini jest niedostępny.
# Bez żadnego klucza czat działa na lokalnym silniku LOCAL_NLP_ENGINE (fallback).
OPENROUTER_API_KEY=""
# Model: darmowe warianty kończą się na ":free" (klucz bez kredytów).
# "openrouter/auto" wymaga środków na koncie OpenRouter.
OPENROUTER_MODEL="minimax/minimax-m3.1-flash:free"

# Fallback NLP — API kompatybilne z OpenAI (Groq lub xAI), darmowy klucz:
# Groq: https://console.groq.com/keys (model np. openai/gpt-oss-120b)
# xAI:  https://console.x.ai/ (zmień wtedy FALLBACK_NLP_BASE_URL na https://api.x.ai/v1)
# Używany, gdy Gemini i OpenRouter są niedostępne lub odrzuca żądanie.
FALLBACK_NLP_BASE_URL="https://api.groq.com/openai/v1"
FALLBACK_NLP_API_KEY=""
FALLBACK_NLP_MODEL="openai/gpt-oss-120b"

# Optional Pro key for image generation. This is not used by the
# deterministic Triad command protocol.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# Optional URL where the app is hosted, used for self-referential links,
# OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
