# ── Czat Triady (Alex, Astyria, Aurelius): swobodna rozmowa ──────────────
# Kolejność: Google Gemini → xAI (Grok) → Ollama (lokalny model) → without_nlp.
# Skopiuj ten plik jako .env i wpisz klucze. Wystarczy jeden z dostawców.
#
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
# Modele zapasowe Gemini (po przecinku), używane przy limicie 429 / braku modelu.
GEMINI_FALLBACK_MODELS="gemini-3.7-flash"
#
# xAI (Grok), fallback: https://console.x.ai/
XAI_API_KEY=""
# Puste = domyślny model; gdy xAI go odrzuci, serwer sam dobiera aktualny
# model Grok z https://api.x.ai/v1/models.
XAI_MODEL=""
#
# Ollama — lokalny model na serwerze, działa bez internetu i bez kluczy.
# Instalacja + automatyczny dobór modelu do RAM/GPU: npm run setup:ollama
OLLAMA_MODEL=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Limit czasu odpowiedzi czatu w sekundach (domyślnie 70, z Ollamą 240).
LLM_TIMEOUT_SEC=""

# OpenRouter API — używany przez konsolę HyperOS (opcjonalnie).
OPENROUTER_API_KEY=""
# Model: darmowe warianty kończą się na ":free" (klucz bez kredytów).
# "openrouter/auto" wymaga środków na koncie OpenRouter.
OPENROUTER_MODEL="minimax/minimax-m3.1-flash:free"

# Fallback NLP — API kompatybilne z OpenAI (Groq lub xAI), darmowy klucz:
# Groq: https://console.groq.com/keys (model np. openai/gpt-oss-120b)
# xAI:  https://console.x.ai/ (zmień wtedy FALLBACK_NLP_BASE_URL na https://api.x.ai/v1)
# Używany, gdy OpenRouter jest niedostępny lub odrzuca żądanie.
FALLBACK_NLP_BASE_URL="https://api.groq.com/openai/v1"
FALLBACK_NLP_API_KEY=""
FALLBACK_NLP_MODEL="openai/gpt-oss-120b"

# Optional Pro key for image generation. This is not used by the
# deterministic Triad command protocol.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# Optional URL where the app is hosted, used for self-referential links,
# OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
