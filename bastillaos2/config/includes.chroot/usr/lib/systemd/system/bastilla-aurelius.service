[Unit]
Description=BastillaOS Triada: Aurelius — audyt bezpieczeństwa
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/bastilla/triad/triad.py run aurelius
StateDirectory=bastilla/triad
Nice=10
IOSchedulingClass=idle
ProtectHome=read-only
PrivateTmp=yes
