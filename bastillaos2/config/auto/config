#!/bin/sh
# Konfiguracja obrazu BastillaOS 2: Debian 13 Trixie, hybrydowe ISO (UEFI + BIOS),
# sesja live z instalatorem Calamares (Btrfs + snapshoty).
set -eu

lb config noauto \
	--mode debian \
	--system live \
	--distribution trixie \
	--architecture amd64 \
	--linux-flavours amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-image iso-hybrid \
	--bootloaders "grub-efi,syslinux" \
	--debian-installer none \
	--firmware-binary true \
	--firmware-chroot true \
	--apt-recommends false \
	--security true \
	--updates true \
	--memtest none \
	--checksums sha256 \
	--image-name bastillaos-2.0-amd64 \
	--iso-application "BastillaOS 2.0 Live" \
	--iso-publisher BastillaOS \
	--iso-volume BASTILLAOS_2_0 \
	--bootappend-live "boot=live components quiet splash locales=pl_PL.UTF-8 keyboard-layouts=pl" \
	"$@"
